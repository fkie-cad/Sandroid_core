/* Sandroid TUI Styles - Evergreen Theme */
/* Warm moss-grey base, cream text, a heather (lilac) accent.
   Tuned for reading dense tables (App lens) for hours. */

/* Color Palette (themes/__init__.py is the source of truth):
   background / lens bg: #1A1F1B
   panel:                #1F2520
   chrome band:          #252C25
   focused cursor:       #283B23
   rule:                 #364036
   text / label / dim:   #EEE6D2 / #BDB6A2 / #A5A08E
   chrome muted text:    #B2AB97
   title / accent:       #CDAEE6 / #B99AD8
   ok / warn / bad:      #98D27F / #EAC55E / #F08474
*/

/* Main screen layout */
Screen {
    background: #1A1F1B;
}

MainScreen {
    layout: vertical;
    background: #1A1F1B;
}

/* Status strip under the header (1-2 rows, full width) */
#status-bar {
    height: auto;
    max-height: 2;
    background: #252C25;
    color: #EEE6D2;
    padding: 0 1;
}

/* Lens frame: the active lens gets the full width */
#lens-host {
    background: #1A1F1B;
    border: round #364036;
    border-title-color: #CDAEE6;
    border-subtitle-color: #B2AB97;
}

#lens-host:focus-within {
    border: round #364036;
}

/* Right-hand side slot: Inspector or AI chat (one at a time) */
Inspector {
    background: #1F2520;
    border: round #364036;
    border-title-color: #CDAEE6;
    border-subtitle-color: #B2AB97;
}

Inspector:focus-within {
    border: round #CDAEE6;
}

#chat-dock {
    background: #1F2520;
    border: round #364036;
    border-title-color: #CDAEE6;
}

/* Log ticker (newest line) + bottom drawer (` toggles) */
LogTicker {
    background: #1F2520;
    color: #B2AB97;
}

#log-ticker-hint {
    color: #B2AB97;
}

LogDrawer {
    background: #1F2520;
    border-top: solid #364036;
}

/* Activity log styling (inside the drawer) */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #1F2520;
}

/* Header scope pill (LIVE) */
#scope-pill.-live {
    color: #98D27F;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #1F2520 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #1F2520;
    border: solid #364036;
    border-title-color: #CDAEE6;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #CDAEE6;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #1F2520;
}

.help-category {
    margin-top: 1;
    color: #CDAEE6;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #EEE6D2;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #B2AB97;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #1F2520;
    border: solid #364036;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #1A1F1B;
    border: solid #CDAEE6;
    color: #EEE6D2;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #1F2520;
}

.palette-item {
    padding: 0 1;
    color: #EEE6D2;
}

.palette-item:hover {
    background: #283B23;
}

.palette-item-selected {
    background: #283B23;
    color: #EEE6D2;
}

.palette-item-key {
    color: #BDB6A2;
    text-style: bold;
}

.palette-item-name {
    color: #EEE6D2;
}

.palette-item-description {
    color: #B2AB97;
}

/* Footer bindings */
SandroidFooter {
    background: #252C25;
    color: #CDAEE6;
}

/* Header */
Header {
    background: #252C25;
    color: #CDAEE6;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #1A1F1B;
}

ScrollableContainer > .scrollbar--bar {
    background: #424D41;
}

/* View indicator colors */
.view-forensic {
    color: #98D27F;
}

.view-malware {
    color: #F08474;
}

.view-security {
    color: #EAC55E;
}

/* Status indicators */
.status-running {
    color: #98D27F;
    text-style: bold;
}

.status-stopped {
    color: #F08474;
}

.status-warning {
    color: #EAC55E;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(26, 31, 27, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #1F2520;
    border: thick #364036;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #CDAEE6;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #BDB6A2;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #1A1F1B;
    border: solid #CDAEE6;
    color: #EEE6D2;
}

#input-field:focus {
    border: solid #B99AD8;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #1A1F1B;
    border: solid #CDAEE6;
    color: #EEE6D2;
}

#filter-input:focus {
    border: solid #B99AD8;
}

/* Compact inputs (the modal sweep's `compact=True`) stay borderless. This
   app stylesheet outranks every widget DEFAULT_CSS -- even Textual's own
   `border: none !important` for compact inputs -- so an ID rule above that
   adds a border (#filter-input) left a 1-row box with no text row: typed
   text was invisible. */
Input.-textual-compact {
    border: none !important;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #1A1F1B;
    border: solid #364036;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #283B23;
    color: #EEE6D2;
}

OptionList > .option-list--option-hover {
    background: #283B23;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #EEE6D2;
}

.toggle-description {
    color: #BDB6A2;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #EEE6D2;
}

.message-info #message-title {
    color: #CDAEE6;
}

.message-warning #message-title {
    color: #EAC55E;
}

.message-error #message-title {
    color: #F08474;
}

.message-info {
    border: thick #CDAEE6;
}

.message-warning {
    border: thick #EAC55E;
}

.message-error {
    border: thick #F08474;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #98D27F;
    color: #1A1F1B;
}

Button.-error {
    background: #F08474;
    color: #1A1F1B;
}

Button {
    background: #B99AD8;
    color: #1A1F1B;
}

Button:hover {
    background: #CDAEE6;
}

Button.-primary {
    background: #B99AD8;
    color: #1A1F1B;
}

/* Logo styling */
.logo-container {
    color: #CDAEE6;
    text-style: bold;
}

.logo-text {
    color: #EEE6D2;
    text-style: bold;
}

.logo-version {
    color: #CDAEE6;
    text-style: bold;
}

.logo-subtitle {
    color: #B2AB97;
}

/* ========== Lens Bar & Chat Panel Theming ========== */
/* Overrides MainScreen/ChatPanel's Python DEFAULT_CSS (see the comments
   there) so the lens bar and AI chat panel follow this theme instead
   of staying frozen on the default Midnight Cyan hardcoded values. */

#lens-bar {
    background: #252C25;
    border-left: heavy #252C25;
}

#lens-bar.-level-active {
    border-left: heavy #B99AD8;
}

.lens-tab {
    color: #B2AB97;
    background: #252C25;
}

.lens-tab:hover {
    color: #EEE6D2;
    background: #283B23;
}

.lens-tab.-active {
    color: #1A1F1B;
    background: #B99AD8;
}

ChatPanel {
    background: #1F2520;
}

ChatPanel > #chat-header {
    color: #CDAEE6;
}

ChatPanel > #chat-log {
    background: #1A1F1B;
}

ChatPanel > #chat-input-bar > #chat-input {
    border: solid #364036;
    background: #1A1F1B;
}

ChatPanel > #chat-mascot {
    /* MUST equal #chat-log's background above -- see the comment on
       ChatPanel > #chat-mascot in chat_panel.py for why. */
    background: #1A1F1B;
    color: #CDAEE6;
}

/* runs lens */
/* Runs lens (DiffsView, #runs-panel): run table cursor, header, empty state. */
#runs-table > .datatable--cursor {
    background: #283B23;
    color: #EEE6D2;
    text-style: none;
}

#runs-table > .datatable--header {
    background: transparent;
    color: #BDB6A2;
}

#runs-empty {
    color: #BDB6A2;
}
/* end runs lens */

/* files lens */
#files-panel, #files-panel > #files-table {
    background: #1A1F1B;
}
#files-panel > #files-table > .datatable--cursor {
    background: #283B23;
    color: #EEE6D2;
}
#files-panel > #files-empty {
    color: #BDB6A2;
}
#files-panel > #files-input {
    background: #1A1F1B;
}
#files-panel #files-notice-text {
    color: #EAC55E;
}
/* end files lens */

/* ========== Dense-data dark theme additions ========== */
/* Chrome whose fallback colors live in Python DEFAULT_CSS (lens_shell.py). */

ShellHeader {
    background: #252C25;
    color: #CDAEE6;
}

#scope-pill.-review {
    color: #1A1F1B;
    background: #EAC55E;
}

#scope-pill.-rec {
    color: #F08474;
}

#scope-pill.-blind {
    color: #F0A866;
}

#device-clock,
#label-note {
    color: #EAC55E;
}

#tracking-dot {
    color: #98D27F;
}

#timeline-banner {
    color: #F0A866;
}

#lens-bar {
    border-left: heavy #252C25;
}

.lens-tab {
    color: #BDB6A2;
}

.lens-tab.-active {
    text-style: bold;
}

#log-ticker-line {
    color: #BDB6A2;
}
