/* Sandroid TUI Styles - Cyberpunk/Neon Theme */
/* Neon colors on dark purple background */

/* Color Palette:
   primary: #FF00FF (Magenta)
   secondary: #00FFFF (Cyan)
   accent: #FFFF00 (Yellow)
   background: #0D0221 (Deep purple-black)
   surface: #1A0A2E (Dark purple)
   error: #FF3366 (Hot pink)
   warning: #FF9900 (Orange)
   success: #00FF9F (Neon green)
   text: #F0F0F0 (Off-white)
   text_muted: #8B8B8B (Grey)
   forensic_color: #00FF9F (Neon green)
   malware_color: #FF3366 (Hot pink)
   security_color: #FFFF00 (Yellow)
   logo_color: #FF00FF (Magenta)
   logo_text_color: #00FFFF (Cyan)
*/

/* Main screen layout */
Screen {
    background: #0D0221;
}

MainScreen {
    layout: horizontal;
    background: #0D0221;
}

/* Left panel - Menu */
#left-panel {
    width: 45%;
    height: 100%;
    background: #1A0A2E;
    border: solid #FF00FF;
    border-title-color: #FF00FF;
    padding: 0 1;
}

/* Right panel - Activity */
#right-panel {
    width: 55%;
    height: 100%;
    background: #1A0A2E;
    border: solid #00FFFF;
    border-title-color: #00FF9F;
    padding: 0 1;
}

/* Status bar at top */
#status-bar {
    dock: top;
    height: 1;
    background: #2A1040;
    color: #FF00FF;
    padding: 0 1;
}

/* Menu panel styling */
MenuPanel {
    height: 100%;
    scrollbar-size: 1 1;
    background: #1A0A2E;
}

#menu-title {
    text-align: center;
    text-style: bold;
    color: #FF00FF;
    padding: 1 0;
}

.menu-category {
    margin-top: 1;
    color: #FF00FF;
    text-style: bold;
}

.menu-item {
    padding-left: 2;
    color: #F0F0F0;
}

.menu-item:hover {
    background: #2A1040;
    color: #00FFFF;
}

.menu-item-key {
    color: #00FFFF;
    text-style: bold;
}

.menu-item-disabled {
    color: #5A5A5A;
}

/* Activity log styling */
ActivityLog {
    height: 100%;
    scrollbar-size: 1 1;
    background: #1A0A2E;
}

#activity-title {
    text-align: center;
    text-style: bold;
    color: #00FF9F;
    padding: 1 0;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #1A0A2E 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #1A0A2E;
    border: solid #FF00FF;
    border-title-color: #FF00FF;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #FF00FF;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #1A0A2E;
}

.help-category {
    margin-top: 1;
    color: #FF00FF;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #F0F0F0;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #8B8B8B;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #1A0A2E;
    border: solid #FF00FF;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #0D0221;
    border: solid #00FFFF;
    color: #F0F0F0;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #1A0A2E;
}

.palette-item {
    padding: 0 1;
    color: #F0F0F0;
}

.palette-item:hover {
    background: #2A1040;
    color: #00FFFF;
}

.palette-item-selected {
    background: #2A1040;
    color: #00FFFF;
}

.palette-item-key {
    color: #00FFFF;
    text-style: bold;
}

.palette-item-name {
    color: #F0F0F0;
}

.palette-item-description {
    color: #8B8B8B;
}

/* Footer bindings */
SandroidFooter {
    background: #2A1040;
    color: #FF00FF;
}

/* Header */
Header {
    background: #2A1040;
    color: #FF00FF;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #0D0221;
}

ScrollableContainer > .scrollbar--bar {
    background: #FF00FF;
}

/* View indicator colors */
.view-forensic {
    color: #00FF9F;
}

.view-malware {
    color: #FF3366;
}

.view-security {
    color: #FFFF00;
}

/* Status indicators */
.status-running {
    color: #00FF9F;
    text-style: bold;
}

.status-stopped {
    color: #FF3366;
}

.status-warning {
    color: #FF9900;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(13, 2, 33, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #1A0A2E;
    border: thick #FF00FF;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #FF00FF;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #8B8B8B;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #0D0221;
    border: solid #00FFFF;
    color: #F0F0F0;
}

#input-field:focus {
    border: solid #FF00FF;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #0D0221;
    border: solid #00FFFF;
    color: #F0F0F0;
}

#filter-input:focus {
    border: solid #FF00FF;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #0D0221;
    border: solid #2A1040;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #2A1040;
    color: #00FFFF;
}

OptionList > .option-list--option-hover {
    background: #2A1040;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #F0F0F0;
}

.toggle-description {
    color: #8B8B8B;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #F0F0F0;
}

.message-info #message-title {
    color: #00FFFF;
}

.message-warning #message-title {
    color: #FF9900;
}

.message-error #message-title {
    color: #FF3366;
}

.message-info {
    border: thick #00FFFF;
}

.message-warning {
    border: thick #FF9900;
}

.message-error {
    border: thick #FF3366;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #00FF9F;
    color: #0D0221;
}

Button.-error {
    background: #FF3366;
    color: #FFFFFF;
}

Button {
    background: #FF00FF;
    color: #0D0221;
}

Button:hover {
    background: #00FFFF;
    color: #0D0221;
}

Button.-primary {
    background: #FF00FF;
    color: #0D0221;
}

/* Logo styling */
.logo-container {
    color: #FF00FF;
    text-style: bold;
}

.logo-text {
    color: #00FFFF;
    text-style: bold;
}

.logo-version {
    color: #FF00FF;
    text-style: bold;
}

.logo-subtitle {
    color: #8B8B8B;
}
