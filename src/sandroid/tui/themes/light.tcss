/* Sandroid TUI Styles - Light Theme */
/* Clean light theme with blue accents */

/* Color Palette:
   primary: #1669BC (Blue)
   secondary: #0D47A1 (Dark blue)
   accent: #007A69 (Teal)
   background: #FAFAFA (Off-white)
   surface: #FFFFFF (White)
   error: #CF2C2C (Red)
   warning: #A95500 (Orange)
   success: #307A34 (Green)
   text: #212121 (Dark grey)
   text_muted: #757575 (Medium grey)
   forensic_color: #307A34 (Green)
   malware_color: #CF2C2C (Red)
   security_color: #A95500 (Orange)
   logo_color: #1669BC (Blue)
   logo_text_color: #0D47A1 (Dark blue)
*/

/* Main screen layout */
Screen {
    background: #FAFAFA;
}

MainScreen {
    layout: vertical;
    background: #FAFAFA;
}

/* Status strip under the header (1-2 rows, full width) */
#status-bar {
    height: auto;
    max-height: 2;
    background: #E3F2FD;
    color: #1669BC;
    padding: 0 1;
}

/* Lens frame: the active lens gets the full width */
#lens-host {
    background: #FFFFFF;
    border: round #E0E0E0;
    border-title-color: #1669BC;
    border-subtitle-color: #757575;
}

#lens-host:focus-within {
    border: round #E0E0E0;
}

/* Right-hand side slot: Inspector (the AI chat docks under the lens and
   styles itself from $lens-* tokens, see main_screen.ChatDock) */
Inspector {
    background: #FFFFFF;
    border: round #E0E0E0;
    border-title-color: #307A34;
    border-subtitle-color: #757575;
}

Inspector:focus-within {
    border: round #1669BC;
}

/* Log ticker (newest line) + bottom drawer (` toggles) */
LogTicker {
    background: #FFFFFF;
    color: #757575;
}

#log-ticker-hint {
    color: #757575;
}

LogDrawer {
    background: #FFFFFF;
    border-top: solid #E0E0E0;
}

/* Activity log styling (inside the drawer) */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #FFFFFF;
}

/* Header scope pill (LIVE) and the other header pieces: their
   DEFAULT_CSS (lens_shell.py ShellHeader) colors are for a dark band. */
#scope-pill.-live {
    color: #307A34;
}

ShellHeader #scope-pill.-review {
    color: #FFFFFF;
    background: #9C4808;
}

ShellHeader #scope-pill.-rec {
    color: #B92525;
}

ShellHeader #scope-pill.-blind,
ShellHeader #timeline-banner {
    color: #C2410C;
}

ShellHeader #label-note {
    color: #9C4808;
}

ShellHeader #tracking-dot {
    color: #296E2C;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #FFFFFF 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #FFFFFF;
    border: solid #E0E0E0;
    border-title-color: #1669BC;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #1669BC;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #FFFFFF;
}

.help-category {
    margin-top: 1;
    color: #1669BC;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #212121;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #757575;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #FFFFFF;
    border: solid #E0E0E0;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #FAFAFA;
    border: solid #1669BC;
    color: #212121;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #FFFFFF;
}

.palette-item {
    padding: 0 1;
    color: #212121;
}

.palette-item:hover {
    background: #E3F2FD;
}

.palette-item-selected {
    background: #E3F2FD;
    color: #212121;
}

.palette-item-key {
    color: #0D47A1;
    text-style: bold;
}

.palette-item-name {
    color: #212121;
}

.palette-item-description {
    color: #757575;
}

/* Footer bindings */
SandroidFooter {
    background: #E3F2FD;
    color: #1669BC;
}

/* Header */
Header {
    background: #E3F2FD;
    color: #1669BC;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #FAFAFA;
}

ScrollableContainer > .scrollbar--bar {
    background: #1669BC;
}

/* View indicator colors */
.view-forensic {
    color: #307A34;
}

.view-malware {
    color: #CF2C2C;
}

.view-security {
    color: #A95500;
}

/* Status indicators */
.status-running {
    color: #007A69;
    text-style: bold;
}

.status-stopped {
    color: #CF2C2C;
}

.status-warning {
    color: #A95500;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(250, 250, 250, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #FFFFFF;
    border: thick #E0E0E0;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #1669BC;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #757575;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #FAFAFA;
    border: solid #1669BC;
    color: #212121;
}

#input-field:focus {
    border: solid #0D47A1;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #FAFAFA;
    border: solid #1669BC;
    color: #212121;
}

#filter-input:focus {
    border: solid #0D47A1;
}

/* Compact inputs (the modal sweep's `compact=True`) stay borderless. This
   app stylesheet outranks every widget DEFAULT_CSS -- even Textual's own
   `border: none !important` for compact inputs -- so an ID rule above that
   adds a border (#filter-input) left a 1-row box with no text row: typed
   text was invisible. */
Input.-textual-compact {
    border: none !important;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #FAFAFA;
    border: solid #E0E0E0;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #E3F2FD;
    color: #212121;
}

OptionList > .option-list--option-hover {
    background: #E3F2FD;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #212121;
}

.toggle-description {
    color: #757575;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #212121;
}

.message-info #message-title {
    color: #1669BC;
}

.message-warning #message-title {
    color: #A95500;
}

.message-error #message-title {
    color: #CF2C2C;
}

.message-info {
    border: thick #1669BC;
}

.message-warning {
    border: thick #A95500;
}

.message-error {
    border: thick #CF2C2C;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #307A34;
    color: #FFFFFF;
}

Button.-error {
    background: #CF2C2C;
    color: #FFFFFF;
}

Button {
    background: #1669BC;
    color: #FFFFFF;
}

Button:hover {
    background: #1565C0;
}

Button.-primary {
    background: #1669BC;
    color: #FFFFFF;
}

/* Logo styling */
.logo-container {
    color: #1669BC;
    text-style: bold;
}

.logo-text {
    color: #0D47A1;
    text-style: bold;
}

.logo-version {
    color: #1669BC;
    text-style: bold;
}

.logo-subtitle {
    color: #757575;
}

/* ========== Lens Bar Theming ========== */
/* Overrides MainScreen's Python DEFAULT_CSS (see the comments
   there) so the lens bar follows this theme instead
   of staying frozen on the default Midnight Cyan hardcoded values. */

#lens-bar {
    background: #FAFAFA;
    border-left: heavy #FAFAFA;
}

#lens-bar.-level-active {
    border-left: heavy #1669BC;
}

.lens-tab {
    color: #757575;
    background: #FAFAFA;
}

.lens-tab:hover {
    color: #212121;
    background: #E3F2FD;
}

.lens-tab.-active {
    color: #FFFFFF;
    background: #1669BC;
}

/* runs lens */
/* Runs lens (DiffsView, #runs-panel): run table cursor, header, empty state. */
#runs-table > .datatable--cursor {
    background: #BBDEFB;
    color: #000000;
    text-style: none;
}

#runs-table > .datatable--header {
    background: transparent;
    color: #757575;
}

#runs-empty {
    color: #757575;
}
/* end runs lens */

/* files lens */
#files-panel, #files-panel > #files-table {
    background: #FFFFFF;
}
#files-panel > #files-table > .datatable--cursor {
    background: #E3F2FD;
    color: #000000;
}
#files-panel > #files-empty {
    color: #616161;
}
#files-panel > #files-input {
    background: #F5F5F5;
}
#files-panel #files-notice-text {
    color: #BE4300;
}
/* end files lens */
