/* Sandroid TUI Styles - Light Theme */
/* Clean light theme with blue accents */

/* Color Palette:
   primary: #1976D2 (Blue)
   secondary: #0D47A1 (Dark blue)
   accent: #00BFA5 (Teal)
   background: #FAFAFA (Off-white)
   surface: #FFFFFF (White)
   error: #D32F2F (Red)
   warning: #F57C00 (Orange)
   success: #388E3C (Green)
   text: #212121 (Dark grey)
   text_muted: #757575 (Medium grey)
   forensic_color: #388E3C (Green)
   malware_color: #D32F2F (Red)
   security_color: #F57C00 (Orange)
   logo_color: #1976D2 (Blue)
   logo_text_color: #0D47A1 (Dark blue)
*/

/* Main screen layout */
Screen {
    background: #FAFAFA;
}

MainScreen {
    layout: horizontal;
    background: #FAFAFA;
}

/* Left panel - Menu */
#left-panel {
    width: 45%;
    height: 100%;
    background: #FFFFFF;
    border: solid #E0E0E0;
    border-title-color: #1976D2;
    padding: 0 1;
}

/* Right panel - Activity */
#right-panel {
    width: 55%;
    height: 100%;
    background: #FFFFFF;
    border: solid #E0E0E0;
    border-title-color: #388E3C;
    padding: 0 1;
}

/* Status bar at top */
#status-bar {
    dock: top;
    height: 1;
    background: #E3F2FD;
    color: #1976D2;
    padding: 0 1;
}

/* Menu panel styling */
MenuPanel {
    height: 100%;
    scrollbar-size: 1 1;
    background: #FFFFFF;
}

#menu-title {
    text-align: center;
    text-style: bold;
    color: #1976D2;
    padding: 1 0;
}

.menu-category {
    margin-top: 1;
    color: #1976D2;
    text-style: bold;
}

.menu-item {
    padding-left: 2;
    color: #212121;
}

.menu-item:hover {
    background: #E3F2FD;
}

.menu-item-key {
    color: #0D47A1;
    text-style: bold;
}

.menu-item-disabled {
    color: #9E9E9E;
}

/* Activity log styling */
ActivityLog {
    height: 100%;
    scrollbar-size: 1 1;
    background: #FFFFFF;
}

#activity-title {
    text-align: center;
    text-style: bold;
    color: #388E3C;
    padding: 1 0;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #FFFFFF 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #FFFFFF;
    border: solid #E0E0E0;
    border-title-color: #1976D2;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #1976D2;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #FFFFFF;
}

.help-category {
    margin-top: 1;
    color: #1976D2;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #212121;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #757575;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #FFFFFF;
    border: solid #E0E0E0;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #FAFAFA;
    border: solid #1976D2;
    color: #212121;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #FFFFFF;
}

.palette-item {
    padding: 0 1;
    color: #212121;
}

.palette-item:hover {
    background: #E3F2FD;
}

.palette-item-selected {
    background: #E3F2FD;
    color: #212121;
}

.palette-item-key {
    color: #0D47A1;
    text-style: bold;
}

.palette-item-name {
    color: #212121;
}

.palette-item-description {
    color: #757575;
}

/* Footer bindings */
SandroidFooter {
    background: #E3F2FD;
    color: #1976D2;
}

/* Header */
Header {
    background: #E3F2FD;
    color: #1976D2;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #FAFAFA;
}

ScrollableContainer > .scrollbar--bar {
    background: #1976D2;
}

/* View indicator colors */
.view-forensic {
    color: #388E3C;
}

.view-malware {
    color: #D32F2F;
}

.view-security {
    color: #F57C00;
}

/* Status indicators */
.status-running {
    color: #00BFA5;
    text-style: bold;
}

.status-stopped {
    color: #D32F2F;
}

.status-warning {
    color: #F57C00;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(250, 250, 250, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #FFFFFF;
    border: thick #E0E0E0;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #1976D2;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #757575;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #FAFAFA;
    border: solid #1976D2;
    color: #212121;
}

#input-field:focus {
    border: solid #0D47A1;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #FAFAFA;
    border: solid #1976D2;
    color: #212121;
}

#filter-input:focus {
    border: solid #0D47A1;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #FAFAFA;
    border: solid #E0E0E0;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #E3F2FD;
    color: #212121;
}

OptionList > .option-list--option-hover {
    background: #E3F2FD;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #212121;
}

.toggle-description {
    color: #757575;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #212121;
}

.message-info #message-title {
    color: #1976D2;
}

.message-warning #message-title {
    color: #F57C00;
}

.message-error #message-title {
    color: #D32F2F;
}

.message-info {
    border: thick #1976D2;
}

.message-warning {
    border: thick #F57C00;
}

.message-error {
    border: thick #D32F2F;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #388E3C;
    color: #FFFFFF;
}

Button.-error {
    background: #D32F2F;
    color: #FFFFFF;
}

Button {
    background: #1976D2;
    color: #FFFFFF;
}

Button:hover {
    background: #1565C0;
}

Button.-primary {
    background: #1976D2;
    color: #FFFFFF;
}

/* Logo styling */
.logo-container {
    color: #1976D2;
    text-style: bold;
}

.logo-text {
    color: #0D47A1;
    text-style: bold;
}

.logo-version {
    color: #1976D2;
    text-style: bold;
}

.logo-subtitle {
    color: #757575;
}
