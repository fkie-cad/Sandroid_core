/* Sandroid TUI Styles - Deep Sea Theme */
/* Blue-slate surfaces, a sea-glass cyan accent, lifted text.
   Tuned for reading dense tables (App lens) for hours. */

/* Color Palette (themes/__init__.py is the source of truth):
   background / lens bg: #14202A
   panel:                #192631
   chrome band:          #1E2D3B
   focused cursor:       #183A58
   rule:                 #2B3D4E
   text / label / dim:   #E3ECF4 / #AABCCD / #91A4B6
   chrome muted text:    #A0B3C5
   title / accent:       #5CD0DA / #3FBCC8
   ok / warn / bad:      #86D68F / #F2C063 / #F7878A
*/

/* Main screen layout */
Screen {
    background: #14202A;
}

MainScreen {
    layout: vertical;
    background: #14202A;
}

/* Status strip under the header (1-2 rows, full width) */
#status-bar {
    height: auto;
    max-height: 2;
    background: #1E2D3B;
    color: #E3ECF4;
    padding: 0 1;
}

/* Lens frame: the active lens gets the full width */
#lens-host {
    background: #14202A;
    border: round #2B3D4E;
    border-title-color: #5CD0DA;
    border-subtitle-color: #A0B3C5;
}

#lens-host:focus-within {
    border: round #2B3D4E;
}

/* Right-hand side slot: Inspector or AI chat (one at a time) */
Inspector {
    background: #192631;
    border: round #2B3D4E;
    border-title-color: #5CD0DA;
    border-subtitle-color: #A0B3C5;
}

Inspector:focus-within {
    border: round #5CD0DA;
}

#chat-dock {
    background: #192631;
    border: round #2B3D4E;
    border-title-color: #5CD0DA;
}

/* Log ticker (newest line) + bottom drawer (` toggles) */
LogTicker {
    background: #192631;
    color: #A0B3C5;
}

#log-ticker-hint {
    color: #A0B3C5;
}

LogDrawer {
    background: #192631;
    border-top: solid #2B3D4E;
}

/* Activity log styling (inside the drawer) */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #192631;
}

/* Header scope pill (LIVE) */
#scope-pill.-live {
    color: #86D68F;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #192631 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #192631;
    border: solid #2B3D4E;
    border-title-color: #5CD0DA;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #5CD0DA;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #192631;
}

.help-category {
    margin-top: 1;
    color: #5CD0DA;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #E3ECF4;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #A0B3C5;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #192631;
    border: solid #2B3D4E;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #14202A;
    border: solid #5CD0DA;
    color: #E3ECF4;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #192631;
}

.palette-item {
    padding: 0 1;
    color: #E3ECF4;
}

.palette-item:hover {
    background: #183A58;
}

.palette-item-selected {
    background: #183A58;
    color: #E3ECF4;
}

.palette-item-key {
    color: #AABCCD;
    text-style: bold;
}

.palette-item-name {
    color: #E3ECF4;
}

.palette-item-description {
    color: #A0B3C5;
}

/* Footer bindings */
SandroidFooter {
    background: #1E2D3B;
    color: #5CD0DA;
}

/* Header */
Header {
    background: #1E2D3B;
    color: #5CD0DA;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #14202A;
}

ScrollableContainer > .scrollbar--bar {
    background: #344A5F;
}

/* View indicator colors */
.view-forensic {
    color: #86D68F;
}

.view-malware {
    color: #F7878A;
}

.view-security {
    color: #F2C063;
}

/* Status indicators */
.status-running {
    color: #86D68F;
    text-style: bold;
}

.status-stopped {
    color: #F7878A;
}

.status-warning {
    color: #F2C063;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(20, 32, 42, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #192631;
    border: thick #2B3D4E;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #5CD0DA;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #AABCCD;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #14202A;
    border: solid #5CD0DA;
    color: #E3ECF4;
}

#input-field:focus {
    border: solid #3FBCC8;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #14202A;
    border: solid #5CD0DA;
    color: #E3ECF4;
}

#filter-input:focus {
    border: solid #3FBCC8;
}

/* Compact inputs (the modal sweep's `compact=True`) stay borderless. This
   app stylesheet outranks every widget DEFAULT_CSS -- even Textual's own
   `border: none !important` for compact inputs -- so an ID rule above that
   adds a border (#filter-input) left a 1-row box with no text row: typed
   text was invisible. */
Input.-textual-compact {
    border: none !important;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #14202A;
    border: solid #2B3D4E;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #183A58;
    color: #E3ECF4;
}

OptionList > .option-list--option-hover {
    background: #183A58;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #E3ECF4;
}

.toggle-description {
    color: #AABCCD;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #E3ECF4;
}

.message-info #message-title {
    color: #5CD0DA;
}

.message-warning #message-title {
    color: #F2C063;
}

.message-error #message-title {
    color: #F7878A;
}

.message-info {
    border: thick #5CD0DA;
}

.message-warning {
    border: thick #F2C063;
}

.message-error {
    border: thick #F7878A;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #86D68F;
    color: #0D1820;
}

Button.-error {
    background: #F7878A;
    color: #0D1820;
}

Button {
    background: #3FBCC8;
    color: #0D1820;
}

Button:hover {
    background: #5CD0DA;
}

Button.-primary {
    background: #3FBCC8;
    color: #0D1820;
}

/* Logo styling */
.logo-container {
    color: #5CD0DA;
    text-style: bold;
}

.logo-text {
    color: #E3ECF4;
    text-style: bold;
}

.logo-version {
    color: #5CD0DA;
    text-style: bold;
}

.logo-subtitle {
    color: #A0B3C5;
}

/* ========== Lens Bar & Chat Panel Theming ========== */
/* Overrides MainScreen/ChatPanel's Python DEFAULT_CSS (see the comments
   there) so the lens bar and AI chat panel follow this theme instead
   of staying frozen on the default Midnight Cyan hardcoded values. */

#lens-bar {
    background: #1E2D3B;
    border-left: heavy #1E2D3B;
}

#lens-bar.-level-active {
    border-left: heavy #3FBCC8;
}

.lens-tab {
    color: #A0B3C5;
    background: #1E2D3B;
}

.lens-tab:hover {
    color: #E3ECF4;
    background: #183A58;
}

.lens-tab.-active {
    color: #0D1820;
    background: #3FBCC8;
}

ChatPanel {
    background: #192631;
}

ChatPanel > #chat-header {
    color: #5CD0DA;
}

ChatPanel > #chat-log {
    background: #14202A;
}

ChatPanel > #chat-input-bar > #chat-input {
    border: solid #2B3D4E;
    background: #14202A;
}

ChatPanel > #chat-mascot {
    /* MUST equal #chat-log's background above -- see the comment on
       ChatPanel > #chat-mascot in chat_panel.py for why. */
    background: #14202A;
    color: #5CD0DA;
}

/* runs lens */
/* Runs lens (DiffsView, #runs-panel): run table cursor, header, empty state. */
#runs-table > .datatable--cursor {
    background: #183A58;
    color: #E3ECF4;
    text-style: none;
}

#runs-table > .datatable--header {
    background: transparent;
    color: #AABCCD;
}

#runs-empty {
    color: #AABCCD;
}
/* end runs lens */

/* files lens */
#files-panel, #files-panel > #files-table {
    background: #14202A;
}
#files-panel > #files-table > .datatable--cursor {
    background: #183A58;
    color: #E3ECF4;
}
#files-panel > #files-empty {
    color: #AABCCD;
}
#files-panel > #files-input {
    background: #14202A;
}
#files-panel #files-notice-text {
    color: #F2C063;
}
/* end files lens */

/* ========== Dense-data dark theme additions ========== */
/* Chrome whose fallback colors live in Python DEFAULT_CSS (lens_shell.py). */

ShellHeader {
    background: #1E2D3B;
    color: #5CD0DA;
}

#scope-pill.-review {
    color: #0D1820;
    background: #F2C063;
}

#scope-pill.-rec {
    color: #F7878A;
}

#scope-pill.-blind {
    color: #F5A962;
}

#device-clock,
#label-note {
    color: #F2C063;
}

#tracking-dot {
    color: #86D68F;
}

#timeline-banner {
    color: #F5A962;
}

#lens-bar {
    border-left: heavy #1E2D3B;
}

.lens-tab {
    color: #AABCCD;
}

.lens-tab.-active {
    text-style: bold;
}

#log-ticker-line {
    color: #AABCCD;
}
