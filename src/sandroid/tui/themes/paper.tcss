/* Sandroid TUI Styles - Paper Theme */
/* Warm off-white paper, ink-like text, one restrained petrol-blue accent. */

/* Color roles (Python side: PAPER_THEME in __init__.py):
   screen: #F3EEE2
   surface: #FBF8F1
   band: #E9E2D2
   tint: #D3E2E9
   accent: #1C5D7C
   title: #174A63
   ink: #1F1C17
   label: #3F6475
   dim: #6B6459
   rule: #D6CCB6
   ok: #2D6A2F
   warn: #8F5600
   bad: #A3302A
*/

/* Main screen layout */
Screen {
    background: #F3EEE2;
}

MainScreen {
    layout: vertical;
    background: #F3EEE2;
}

/* Status strip under the header (1-2 rows, full width) */
#status-bar {
    height: auto;
    max-height: 2;
    background: #E9E2D2;
    color: #1C5D7C;
    padding: 0 1;
}

/* Lens frame: the active lens gets the full width */
#lens-host {
    background: #FBF8F1;
    border: round #D6CCB6;
    border-title-color: #1C5D7C;
    border-subtitle-color: #6B6459;
}

#lens-host:focus-within {
    border: round #D6CCB6;
}

/* Right-hand side slot: Inspector or AI chat (one at a time) */
Inspector {
    background: #FBF8F1;
    border: round #D6CCB6;
    border-title-color: #174A63;
    border-subtitle-color: #6B6459;
}

Inspector:focus-within {
    border: round #1C5D7C;
}

#chat-dock {
    background: #FBF8F1;
    border: round #D6CCB6;
    border-title-color: #174A63;
}

/* Log ticker (newest line) + bottom drawer (` toggles) */
LogTicker {
    background: #FBF8F1;
    color: #6B6459;
}

#log-ticker-hint {
    color: #6B6459;
}

LogDrawer {
    background: #FBF8F1;
    border-top: solid #D6CCB6;
}

/* Activity log styling (inside the drawer) */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #FBF8F1;
}

/* Header scope pill (LIVE) */
#scope-pill.-live {
    color: #2D6A2F;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #FBF8F1 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #FBF8F1;
    border: solid #D6CCB6;
    border-title-color: #1C5D7C;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #1C5D7C;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #FBF8F1;
}

.help-category {
    margin-top: 1;
    color: #1C5D7C;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #1F1C17;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #6B6459;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #FBF8F1;
    border: solid #D6CCB6;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #F3EEE2;
    border: solid #1C5D7C;
    color: #1F1C17;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #FBF8F1;
}

.palette-item {
    padding: 0 1;
    color: #1F1C17;
}

.palette-item:hover {
    background: #D3E2E9;
}

.palette-item-selected {
    background: #D3E2E9;
    color: #1F1C17;
}

.palette-item-key {
    color: #174A63;
    text-style: bold;
}

.palette-item-name {
    color: #1F1C17;
}

.palette-item-description {
    color: #6B6459;
}

/* Footer bindings */
SandroidFooter {
    background: #E9E2D2;
    color: #1C5D7C;
}

/* Header */
Header {
    background: #E9E2D2;
    color: #1C5D7C;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #F3EEE2;
}

ScrollableContainer > .scrollbar--bar {
    background: #1C5D7C;
}

/* View indicator colors */
.view-forensic {
    color: #2D6A2F;
}

.view-malware {
    color: #A3302A;
}

.view-security {
    color: #8F5600;
}

/* Status indicators */
.status-running {
    color: #2D6A2F;
    text-style: bold;
}

.status-stopped {
    color: #A3302A;
}

.status-warning {
    color: #8F5600;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(243, 238, 226, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #FBF8F1;
    border: thick #D6CCB6;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #1C5D7C;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #6B6459;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #F3EEE2;
    border: solid #1C5D7C;
    color: #1F1C17;
}

#input-field:focus {
    border: solid #174A63;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #F3EEE2;
    border: solid #1C5D7C;
    color: #1F1C17;
}

#filter-input:focus {
    border: solid #174A63;
}

/* Compact inputs (the modal sweep's `compact=True`) stay borderless. This
   app stylesheet outranks every widget DEFAULT_CSS -- even Textual's own
   `border: none !important` for compact inputs -- so an ID rule above that
   adds a border (#filter-input) left a 1-row box with no text row: typed
   text was invisible. */
Input.-textual-compact {
    border: none !important;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #F3EEE2;
    border: solid #D6CCB6;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #D3E2E9;
    color: #1F1C17;
}

OptionList > .option-list--option-hover {
    background: #D3E2E9;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #1F1C17;
}

.toggle-description {
    color: #6B6459;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #1F1C17;
}

.message-info #message-title {
    color: #1C5D7C;
}

.message-warning #message-title {
    color: #8F5600;
}

.message-error #message-title {
    color: #A3302A;
}

.message-info {
    border: thick #1C5D7C;
}

.message-warning {
    border: thick #8F5600;
}

.message-error {
    border: thick #A3302A;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #2D6A2F;
    color: #FFFFFF;
}

Button.-error {
    background: #A3302A;
    color: #FFFFFF;
}

Button {
    background: #1C5D7C;
    color: #FFFFFF;
}

Button:hover {
    background: #174A63;
}

Button.-primary {
    background: #1C5D7C;
    color: #FFFFFF;
}

/* Logo styling */
.logo-container {
    color: #1C5D7C;
    text-style: bold;
}

.logo-text {
    color: #174A63;
    text-style: bold;
}

.logo-version {
    color: #1C5D7C;
    text-style: bold;
}

.logo-subtitle {
    color: #6B6459;
}

/* ========== Lens Bar & Chat Panel Theming ========== */
/* Overrides MainScreen/ChatPanel's Python DEFAULT_CSS (see the comments
   there) so the lens bar and AI chat panel follow this theme instead
   of staying frozen on the default Midnight Cyan hardcoded values. */

#lens-bar {
    background: #F3EEE2;
    border-left: heavy #F3EEE2;
}

#lens-bar.-level-active {
    border-left: heavy #1C5D7C;
}

.lens-tab {
    color: #6B6459;
    background: #F3EEE2;
}

.lens-tab:hover {
    color: #1F1C17;
    background: #D3E2E9;
}

.lens-tab.-active {
    color: #FFFFFF;
    background: #1C5D7C;
}

ChatPanel {
    background: #FBF8F1;
}

ChatPanel > #chat-header {
    color: #1C5D7C;
}

ChatPanel > #chat-log {
    background: #F3EEE2;
}

ChatPanel > #chat-input-bar > #chat-input {
    border: solid #D6CCB6;
    background: #F3EEE2;
}

ChatPanel > #chat-mascot {
    /* MUST equal #chat-log's background above -- see the comment on
       ChatPanel > #chat-mascot in chat_panel.py for why. */
    background: #F3EEE2;
    color: #1C5D7C;
}

/* runs lens */
/* Runs lens (DiffsView, #runs-panel): run table cursor, header, empty state. */
#runs-table > .datatable--cursor {
    background: #D3E2E9;
    color: #1F1C17;
    text-style: none;
}

#runs-table > .datatable--header {
    background: transparent;
    color: #6B6459;
}

#runs-empty {
    color: #6B6459;
}
/* end runs lens */

/* files lens */
#files-panel, #files-panel > #files-table {
    background: #FBF8F1;
}
#files-panel > #files-table > .datatable--cursor {
    background: #D3E2E9;
    color: #1F1C17;
}
#files-panel > #files-empty {
    color: #6B6459;
}
#files-panel > #files-input {
    background: #F3EEE2;
}
#files-panel #files-notice-text {
    color: #8F5600;
}
/* end files lens */

/* ========== Chrome tuned for a light background ========== */
/* The shell widgets' DEFAULT_CSS (lens_shell.py: ShellHeader, LensBar,
   LogTicker, LogDrawer) hardcode colors for a dark background; this file
   outranks DEFAULT_CSS, so these rules re-color them for this theme.
   Paper keeps all chrome on paper: kraft-colored bars, ink text. */

ShellHeader {
    background: #E9E2D2;
    color: #174A63;
}

ShellHeader #scope-pill,
#scope-pill.-live {
    color: #2D6A2F;
}

ShellHeader #scope-pill.-review {
    color: #FFFFFF;
    background: #8F5600;
}

ShellHeader #scope-pill.-rec {
    color: #A3302A;
}

ShellHeader #scope-pill.-blind,
ShellHeader #timeline-banner {
    color: #9C4A00;
}

ShellHeader #device-clock,
ShellHeader #label-note {
    color: #8F5600;
}

ShellHeader #tracking-dot {
    color: #2D6A2F;
}

ShellHeader HeaderClock {
    background: #DFD6C3;
    color: #174A63;
}

#status-bar {
    background: #EDE7DA;
}

#lens-bar,
LensBar {
    background: #F3EEE2;
    border-left: heavy #F3EEE2;
}

#lens-bar.-level-active {
    border-left: heavy #1C5D7C;
}

LensBar .lens-tab {
    color: #6B6459;
    background: #F3EEE2;
}

LensBar .lens-tab:hover {
    color: #1F1C17;
    background: #D3E2E9;
}

LensBar .lens-tab.-active {
    color: #FFFFFF;
    background: #1C5D7C;
}

#lens-host:focus-within {
    border: round #B9AE98;
}

LogTicker {
    background: #F3EEE2;
    color: #3F6475;
}

LogTicker #log-ticker-hint {
    color: #6B6459;
}

LogDrawer {
    background: #FBF8F1;
    border-top: solid #D6CCB6;
}

SandroidFooter {
    background: #ECE5D6;
    color: #1F1C17;
}
