/* Sandroid TUI Styles - Nord/Arctic Theme */
/* Inspired by the Nord color palette - arctic, north-bluish colors */

/* Color Palette:
   primary: #88C0D0 (Frost blue)
   secondary: #81A1C1 (Storm blue)
   accent: #A3BE8C (Aurora green)
   background: #2E3440 (Polar night)
   surface: #3B4252 (Polar night lighter)
   error: #BF616A (Aurora red)
   warning: #EBCB8B (Aurora yellow)
   success: #A3BE8C (Aurora green)
   text: #ECEFF4 (Snow storm)
   text_muted: #4C566A (Polar night lightest)
   forensic_color: #A3BE8C (Aurora green)
   malware_color: #BF616A (Aurora red)
   security_color: #EBCB8B (Aurora yellow)
   logo_color: #88C0D0 (Frost blue)
   logo_text_color: #ECEFF4 (Snow white)
*/

/* Main screen layout */
Screen {
    background: #2E3440;
}

MainScreen {
    layout: horizontal;
    background: #2E3440;
}

/* Left panel - Menu */
#left-panel {
    width: 45%;
    height: 100%;
    background: #3B4252;
    border: solid #4C566A;
    border-title-color: #88C0D0;
    padding: 0 1;
}

/* Right panel - Activity */
#right-panel {
    width: 55%;
    height: 100%;
    background: #3B4252;
    border: solid #4C566A;
    border-title-color: #A3BE8C;
    padding: 0 1;
}

/* Status bar at top */
#status-bar {
    dock: top;
    height: auto;
    background: #434C5E;
    color: #88C0D0;
    padding: 0 1;
}

/* Activity log styling */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #3B4252;
}

#activity-title {
    text-align: center;
    text-style: bold;
    color: #A3BE8C;
    padding: 1 0;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #3B4252 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #3B4252;
    border: solid #4C566A;
    border-title-color: #88C0D0;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #88C0D0;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #3B4252;
}

.help-category {
    margin-top: 1;
    color: #88C0D0;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #ECEFF4;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #4C566A;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #3B4252;
    border: solid #4C566A;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #2E3440;
    border: solid #88C0D0;
    color: #ECEFF4;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #3B4252;
}

.palette-item {
    padding: 0 1;
    color: #ECEFF4;
}

.palette-item:hover {
    background: #434C5E;
}

.palette-item-selected {
    background: #434C5E;
    color: #ECEFF4;
}

.palette-item-key {
    color: #81A1C1;
    text-style: bold;
}

.palette-item-name {
    color: #ECEFF4;
}

.palette-item-description {
    color: #4C566A;
}

/* Footer bindings */
SandroidFooter {
    background: #434C5E;
    color: #88C0D0;
}

/* Header */
Header {
    background: #434C5E;
    color: #88C0D0;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #2E3440;
}

ScrollableContainer > .scrollbar--bar {
    background: #88C0D0;
}

/* View indicator colors */
.view-forensic {
    color: #A3BE8C;
}

.view-malware {
    color: #BF616A;
}

.view-security {
    color: #EBCB8B;
}

/* Status indicators */
.status-running {
    color: #A3BE8C;
    text-style: bold;
}

.status-stopped {
    color: #BF616A;
}

.status-warning {
    color: #EBCB8B;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(46, 52, 64, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #3B4252;
    border: thick #4C566A;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #88C0D0;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #D8DEE9;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #2E3440;
    border: solid #88C0D0;
    color: #ECEFF4;
}

#input-field:focus {
    border: solid #81A1C1;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #2E3440;
    border: solid #88C0D0;
    color: #ECEFF4;
}

#filter-input:focus {
    border: solid #81A1C1;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #2E3440;
    border: solid #4C566A;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #434C5E;
    color: #ECEFF4;
}

OptionList > .option-list--option-hover {
    background: #434C5E;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #ECEFF4;
}

.toggle-description {
    color: #D8DEE9;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #ECEFF4;
}

.message-info #message-title {
    color: #88C0D0;
}

.message-warning #message-title {
    color: #EBCB8B;
}

.message-error #message-title {
    color: #BF616A;
}

.message-info {
    border: thick #88C0D0;
}

.message-warning {
    border: thick #EBCB8B;
}

.message-error {
    border: thick #BF616A;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #A3BE8C;
    color: #2E3440;
}

Button.-error {
    background: #BF616A;
    color: #ECEFF4;
}

Button {
    background: #88C0D0;
    color: #2E3440;
}

Button:hover {
    background: #81A1C1;
}

Button.-primary {
    background: #88C0D0;
    color: #2E3440;
}

/* Logo styling */
.logo-container {
    color: #88C0D0;
    text-style: bold;
}

.logo-text {
    color: #ECEFF4;
    text-style: bold;
}

.logo-version {
    color: #88C0D0;
    text-style: bold;
}

.logo-subtitle {
    color: #4C566A;
}

/* ========== Tool Panel & Chat Panel Theming ========== */
/* Overrides MainScreen/ChatPanel's Python DEFAULT_CSS (see the comments
   there) so the tool-tab strip and AI chat panel follow this theme instead
   of staying frozen on the default Midnight Cyan hardcoded values. */

#tool-tabbar {
    background: #2E3440;
}

.tool-tab {
    color: #4C566A;
    background: #3B4252;
}

.tool-tab:hover {
    color: #ECEFF4;
    background: #434C5E;
}

.tool-tab.-active {
    color: #2E3440;
    background: #88C0D0;
}

#tool-body {
    border-top: solid #4C566A;
}

#chat-dock {
    border-top: solid #4C566A;
}

ChatPanel {
    background: #3B4252;
}

ChatPanel > #chat-header {
    color: #88C0D0;
}

ChatPanel > #chat-log {
    background: #2E3440;
}

ChatPanel > #chat-input-bar > #chat-input {
    border: solid #4C566A;
    background: #2E3440;
}

ChatPanel > #chat-mascot {
    /* MUST equal #chat-log's background above -- see the comment on
       ChatPanel > #chat-mascot in chat_panel.py for why. */
    background: #2E3440;
    color: #88C0D0;
}
