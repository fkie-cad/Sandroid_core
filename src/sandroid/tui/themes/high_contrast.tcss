/* Sandroid TUI Styles - High Contrast Theme */
/* Maximum contrast for accessibility */

/* Color Palette:
   primary: #FFFF00 (Yellow)
   secondary: #00FFFF (Cyan)
   accent: #FF00FF (Magenta)
   background: #000000 (Pure black)
   surface: #000000 (Pure black)
   error: #FF0000 (Pure red)
   warning: #FFFF00 (Yellow)
   success: #00FF00 (Pure green)
   text: #FFFFFF (Pure white)
   text_muted: #CCCCCC (Light grey)
   forensic_color: #00FF00 (Green)
   malware_color: #FF0000 (Red)
   security_color: #FFFF00 (Yellow)
   logo_color: #00FF00 (Green)
   logo_text_color: #FFFF00 (Yellow)
*/

/* Main screen layout */
Screen {
    background: #000000;
}

MainScreen {
    layout: vertical;
    background: #000000;
}

/* Status strip under the header (1-2 rows, full width) */
#status-bar {
    height: auto;
    max-height: 2;
    background: #000000;
    color: #FFFF00;
    padding: 0 1;
}

/* Lens frame: the active lens gets the full width */
#lens-host {
    background: #000000;
    border: round #FFFFFF;
    border-title-color: #FFFF00;
    border-subtitle-color: #CCCCCC;
}

#lens-host:focus-within {
    border: round #FFFFFF;
}

/* Right-hand side slot: Inspector or AI chat (one at a time) */
Inspector {
    background: #000000;
    border: round #FFFFFF;
    border-title-color: #00FF00;
    border-subtitle-color: #CCCCCC;
}

Inspector:focus-within {
    border: round #FFFF00;
}

#chat-dock {
    background: #000000;
    border: round #FFFFFF;
    border-title-color: #00FF00;
}

/* Log ticker (newest line) + bottom drawer (` toggles) */
LogTicker {
    background: #000000;
    color: #CCCCCC;
}

#log-ticker-hint {
    color: #CCCCCC;
}

LogDrawer {
    background: #000000;
    border-top: solid #FFFFFF;
}

/* Activity log styling (inside the drawer) */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #000000;
}

/* Header scope pill (LIVE) */
#scope-pill.-live {
    color: #00FF00;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #000000 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #000000;
    border: solid #FFFFFF;
    border-title-color: #FFFF00;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #FFFF00;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #000000;
}

.help-category {
    margin-top: 1;
    color: #FFFF00;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #FFFFFF;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #CCCCCC;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #000000;
    border: solid #FFFFFF;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #000000;
    border: solid #FFFF00;
    color: #FFFFFF;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #000000;
}

.palette-item {
    padding: 0 1;
    color: #FFFFFF;
}

.palette-item:hover {
    background: #333333;
    color: #FFFF00;
}

.palette-item-selected {
    background: #333333;
    color: #FFFF00;
}

.palette-item-key {
    color: #00FFFF;
    text-style: bold;
}

.palette-item-name {
    color: #FFFFFF;
}

.palette-item-description {
    color: #CCCCCC;
}

/* Footer bindings */
SandroidFooter {
    background: #000000;
    color: #FFFF00;
}

/* Header */
Header {
    background: #000000;
    color: #FFFF00;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #000000;
}

ScrollableContainer > .scrollbar--bar {
    background: #FFFF00;
}

/* View indicator colors */
.view-forensic {
    color: #00FF00;
}

.view-malware {
    color: #FF0000;
}

.view-security {
    color: #FFFF00;
}

/* Status indicators */
.status-running {
    color: #00FF00;
    text-style: bold;
}

.status-stopped {
    color: #FF0000;
}

.status-warning {
    color: #FFFF00;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #000000;
    border: thick #FFFFFF;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #FFFF00;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #CCCCCC;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #000000;
    border: solid #FFFF00;
    color: #FFFFFF;
}

#input-field:focus {
    border: solid #00FFFF;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #000000;
    border: solid #FFFF00;
    color: #FFFFFF;
}

#filter-input:focus {
    border: solid #00FFFF;
}

/* Compact inputs (the modal sweep's `compact=True`) stay borderless. This
   app stylesheet outranks every widget DEFAULT_CSS -- even Textual's own
   `border: none !important` for compact inputs -- so an ID rule above that
   adds a border (#filter-input) left a 1-row box with no text row: typed
   text was invisible. */
Input.-textual-compact {
    border: none !important;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #000000;
    border: solid #FFFFFF;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #333333;
    color: #FFFF00;
}

OptionList > .option-list--option-hover {
    background: #333333;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #FFFFFF;
}

.toggle-description {
    color: #CCCCCC;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #FFFFFF;
}

.message-info #message-title {
    color: #00FFFF;
}

.message-warning #message-title {
    color: #FFFF00;
}

.message-error #message-title {
    color: #FF0000;
}

.message-info {
    border: thick #00FFFF;
}

.message-warning {
    border: thick #FFFF00;
}

.message-error {
    border: thick #FF0000;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #00FF00;
    color: #000000;
}

Button.-error {
    background: #FF0000;
    color: #FFFFFF;
}

Button {
    background: #FFFF00;
    color: #000000;
}

Button:hover {
    background: #FFFFFF;
    color: #000000;
}

Button.-primary {
    background: #FFFF00;
    color: #000000;
}

/* Logo styling */
.logo-container {
    color: #00FF00;
    text-style: bold;
}

.logo-text {
    color: #FFFF00;
    text-style: bold;
}

.logo-version {
    color: #FFFF00;
    text-style: bold;
}

.logo-subtitle {
    color: #CCCCCC;
}

/* ========== Lens Bar & Chat Panel Theming ========== */
/* Overrides MainScreen/ChatPanel's Python DEFAULT_CSS (see the comments
   there) so the lens bar and AI chat panel follow this theme instead
   of staying frozen on the default Midnight Cyan hardcoded values. */

#lens-bar {
    background: #000000;
    border-left: heavy #000000;
}

#lens-bar.-level-active {
    border-left: heavy #FFFF00;
}

.lens-tab {
    color: #CCCCCC;
    background: #000000;
}

.lens-tab:hover {
    color: #FFFF00;
    background: #333333;
}

.lens-tab.-active {
    color: #000000;
    background: #FFFF00;
}

ChatPanel {
    background: #000000;
}

ChatPanel > #chat-header {
    color: #FFFF00;
}

ChatPanel > #chat-log {
    background: #000000;
}

ChatPanel > #chat-input-bar > #chat-input {
    border: solid #FFFFFF;
    background: #000000;
}

ChatPanel > #chat-mascot {
    /* MUST equal #chat-log's background above -- see the comment on
       ChatPanel > #chat-mascot in chat_panel.py for why. */
    background: #000000;
    color: #FFFF00;
}

/* runs lens */
/* Runs lens (DiffsView, #runs-panel): run table cursor, header, empty state. */
#runs-table > .datatable--cursor {
    background: #FFFF00;
    color: #000000;
    text-style: none;
}

#runs-table > .datatable--header {
    background: transparent;
    color: #CCCCCC;
}

#runs-empty {
    color: #CCCCCC;
}
/* end runs lens */

/* files lens */
#files-panel, #files-panel > #files-table {
    background: #000000;
}
#files-panel > #files-table > .datatable--cursor {
    background: #FFFF00;
    color: #000000;
}
#files-panel > #files-empty {
    color: #FFFFFF;
}
#files-panel > #files-input {
    background: #000000;
}
#files-panel #files-notice-text {
    color: #FFFF00;
}
/* end files lens */
