/* Sandroid TUI Styles - High Contrast Theme */
/* Maximum contrast for accessibility */

/* Color Palette:
   primary: #FFFF00 (Yellow)
   secondary: #00FFFF (Cyan)
   accent: #FF00FF (Magenta)
   background: #000000 (Pure black)
   surface: #000000 (Pure black)
   error: #FF0000 (Pure red)
   warning: #FFFF00 (Yellow)
   success: #00FF00 (Pure green)
   text: #FFFFFF (Pure white)
   text_muted: #CCCCCC (Light grey)
   forensic_color: #00FF00 (Green)
   malware_color: #FF0000 (Red)
   security_color: #FFFF00 (Yellow)
   logo_color: #00FF00 (Green)
   logo_text_color: #FFFF00 (Yellow)
*/

/* Main screen layout */
Screen {
    background: #000000;
}

MainScreen {
    layout: horizontal;
    background: #000000;
}

/* Left panel - Menu */
#left-panel {
    width: 45%;
    height: 100%;
    background: #000000;
    border: solid #FFFFFF;
    border-title-color: #FFFF00;
    padding: 0 1;
}

/* Right panel - Activity */
#right-panel {
    width: 55%;
    height: 100%;
    background: #000000;
    border: solid #FFFFFF;
    border-title-color: #00FF00;
    padding: 0 1;
}

/* Status bar at top */
#status-bar {
    dock: top;
    height: auto;
    background: #000000;
    color: #FFFF00;
    padding: 0 1;
}

/* Activity log styling */
ActivityLog {
    height: 1fr;
    min-height: 3;
    scrollbar-size: 1 1;
    background: #000000;
}

#activity-title {
    text-align: center;
    text-style: bold;
    color: #00FF00;
    padding: 1 0;
}

/* Help screen overlay */
HelpScreen {
    align: center middle;
    background: #000000 60%;
}

#help-container {
    width: 80%;
    height: 80%;
    background: #000000;
    border: solid #FFFFFF;
    border-title-color: #FFFF00;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #FFFF00;
    padding: 1 0;
}

#help-content {
    height: 100%;
    scrollbar-size: 1 1;
    background: #000000;
}

.help-category {
    margin-top: 1;
    color: #FFFF00;
    text-style: bold;
}

.help-item {
    padding-left: 2;
    color: #FFFFFF;
}

.help-footer {
    dock: bottom;
    height: 1;
    text-align: center;
    color: #CCCCCC;
}

/* Command palette screen */
CommandPalette {
    align: center top;
    padding-top: 5;
}

#palette-container {
    width: 60%;
    max-height: 60%;
    background: #000000;
    border: solid #FFFFFF;
    padding: 1;
}

#palette-input {
    dock: top;
    width: 100%;
    background: #000000;
    border: solid #FFFF00;
    color: #FFFFFF;
    padding: 0 1;
}

#palette-results {
    height: auto;
    max-height: 20;
    background: #000000;
}

.palette-item {
    padding: 0 1;
    color: #FFFFFF;
}

.palette-item:hover {
    background: #333333;
    color: #FFFF00;
}

.palette-item-selected {
    background: #333333;
    color: #FFFF00;
}

.palette-item-key {
    color: #00FFFF;
    text-style: bold;
}

.palette-item-name {
    color: #FFFFFF;
}

.palette-item-description {
    color: #CCCCCC;
}

/* Footer bindings */
SandroidFooter {
    background: #000000;
    color: #FFFF00;
}

/* Header */
Header {
    background: #000000;
    color: #FFFF00;
}

/* Scrollbar styling */
ScrollableContainer > .scrollbar {
    background: #000000;
}

ScrollableContainer > .scrollbar--bar {
    background: #FFFF00;
}

/* View indicator colors */
.view-forensic {
    color: #00FF00;
}

.view-malware {
    color: #FF0000;
}

.view-security {
    color: #FFFF00;
}

/* Status indicators */
.status-running {
    color: #00FF00;
    text-style: bold;
}

.status-stopped {
    color: #FF0000;
}

.status-warning {
    color: #FFFF00;
}

/* ========== Modal Styles ========== */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.9);
}

#input-modal-container,
#selection-modal-container,
#toggle-modal-container,
#confirm-modal-container,
#message-modal-container {
    background: #000000;
    border: thick #FFFFFF;
    padding: 1 2;
    width: 60;
    max-width: 80%;
    max-height: 80%;
}

#input-title,
#selection-title,
#toggle-title,
#confirm-title,
#message-title {
    text-style: bold;
    color: #FFFF00;
    margin-bottom: 1;
    text-align: center;
}

#input-message,
#selection-message,
#toggle-message,
#confirm-message {
    color: #CCCCCC;
    margin-bottom: 1;
}

#input-field {
    margin: 1 0;
    background: #000000;
    border: solid #FFFF00;
    color: #FFFFFF;
}

#input-field:focus {
    border: solid #00FFFF;
}

#input-buttons {
    margin-top: 1;
    align: center middle;
}

#filter-input {
    margin-bottom: 1;
    background: #000000;
    border: solid #FFFF00;
    color: #FFFFFF;
}

#filter-input:focus {
    border: solid #00FFFF;
}

#option-list {
    height: auto;
    max-height: 15;
    background: #000000;
    border: solid #FFFFFF;
    margin-bottom: 1;
}

OptionList > .option-list--option-highlighted {
    background: #333333;
    color: #FFFF00;
}

OptionList > .option-list--option-hover {
    background: #333333;
}

#toggle-options {
    max-height: 15;
    margin-bottom: 1;
}

.toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.toggle-row Switch {
    margin-right: 2;
}

.toggle-label-container {
    height: auto;
}

.toggle-label {
    text-style: bold;
    color: #FFFFFF;
}

.toggle-description {
    color: #CCCCCC;
}

#toggle-buttons {
    margin-top: 1;
    align: center middle;
}

#confirm-modal-container {
    width: 40;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#message-content {
    margin: 1 0;
    max-height: 10;
    color: #FFFFFF;
}

.message-info #message-title {
    color: #00FFFF;
}

.message-warning #message-title {
    color: #FFFF00;
}

.message-error #message-title {
    color: #FF0000;
}

.message-info {
    border: thick #00FFFF;
}

.message-warning {
    border: thick #FFFF00;
}

.message-error {
    border: thick #FF0000;
}

#input-buttons Button,
#toggle-buttons Button,
#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

Button.-success {
    background: #00FF00;
    color: #000000;
}

Button.-error {
    background: #FF0000;
    color: #FFFFFF;
}

Button {
    background: #FFFF00;
    color: #000000;
}

Button:hover {
    background: #FFFFFF;
    color: #000000;
}

Button.-primary {
    background: #FFFF00;
    color: #000000;
}

/* Logo styling */
.logo-container {
    color: #00FF00;
    text-style: bold;
}

.logo-text {
    color: #FFFF00;
    text-style: bold;
}

.logo-version {
    color: #FFFF00;
    text-style: bold;
}

.logo-subtitle {
    color: #CCCCCC;
}
